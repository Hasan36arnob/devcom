# Public Environment Variables (Safe for Frontend)
# These are the only variables that should be in the frontend .env file

# Application Settings
REACT_APP_API_URL=/api
REACT_APP_FREE_SHIPPING_THRESHOLD=1000
REACT_APP_DEFAULT_CURRENCY=BDT
REACT_APP_CURRENCY_SYMBOL=৳
REACT_APP_TAX_RATE=0.15

# Admin Credentials (for localStorage authentication)
REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_PASSWORD=your_secure_password_here

# Site URL (for payment callbacks)
REACT_APP_SITE_URL=http://localhost:3000
